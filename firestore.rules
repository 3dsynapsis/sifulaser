rules_version = '2';

// Rekod user: setiap orang hanya boleh baca rekod sendiri dan tidak boleh
// menukar status bayaran sendiri. Hanya akaun admin (satu email sahaja) boleh
// melihat semua rekod dan meluluskan akses melalui Panel Admin di app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == '3dsynapsis@gmail.com';
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);

      // A new record may carry these six fields and nothing else, and the
      // three that decide anything have to start empty. Checking only
      // `paid == false` left the rest wide open: a user could write their own
      // record with plan: "class" and take a seat in the count on the admin
      // panel - enough of them and it would report the class full and turn
      // real customers away. Access itself was never reachable that way, since
      // `paid` stays false and only an admin may update, but a booking system
      // anyone can fill with ghosts is still broken.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['email', 'name', 'paid', 'paidUntil', 'plan', 'createdAt'])
        && request.resource.data.paid == false
        && request.resource.data.paidUntil == null
        && request.resource.data.plan == null;

      // Hanya admin boleh menukar status bayaran dan penanda pakej,
      // dan hanya medan tersebut sahaja.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paid', 'paidUntil', 'plan']);

      allow delete: if false;
    }

    // Semua koleksi lain ditutup secara lalai.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
